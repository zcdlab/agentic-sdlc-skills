#!/bin/sh
# Block commits that break the skill scripts or put test code / artifacts into skills/.
# Enable once per clone: git config core.hooksPath .githooks
cd "$(git rev-parse --show-toplevel)" || exit 1
PYTHONDONTWRITEBYTECODE=1 python3 -B -m unittest discover -s tests -q || {
  echo "pre-commit: tests failed - fix them (don't skip the hook)." >&2
  exit 1
}
